{
  "name": "vishwa-vani",
  "version": "1.1.0",
  "private": true,
  "scripts": {
    "vishwa": "./scripts/vishwa.sh",
    "dev": "next dev",
    "dev:lan": "next dev -H 0.0.0.0",
    "build": "next build",
    "start": "next start",
    "start:lan": "next start -H 0.0.0.0",
    "lint": "eslint . --ext .ts,.tsx,.js,.jsx",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "test:watch": "jest --watch",
    "validate": "node scripts/validate_silver.js --all",
    "promote": "node scripts/promote_to_gold.js",
    "audit:gold": "node scripts/audit_gold.js --all",
    "audit:multilang": "node scripts/audit_multilang.js --all",
    "audit:standards": "node scripts/audit_standards.js --all",
    "audit:silver": "node scripts/audit_standards.js --silver --all",
    "audit:all": "npm run audit:gold && npm run audit:multilang && npm run audit:standards",
    "pipeline": "node scripts/run_pipeline.js",
    "pipeline:dry": "node scripts/run_pipeline.js --all --dry-run",
    "strip": "node scripts/strip_placeholders.js",
    "prepare": "git config core.hooksPath .githooks",
    "verify": "npm run lint && npx tsc --noEmit && npm test -- --ci"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@libsql/client": "^0.18.0",
    "@next/third-parties": "^16.3.8",
    "@tailwindcss/typography": "^0.5.19",
    "@types/sql.js": "^1.4.9",
    "@upstash/ratelimit": "^2.2.0",
    "@upstash/redis": "^1.39.0",
    "@vercel/analytics": "^2.0.1",
    "@xenova/transformers": "^2.17.2",
    "better-sqlite3": "^13.0.3",
    "cheerio": "^1.0.0",
    "crawlee": "^3.16.0",
    "dotenv": "^18.0.6",
    "lucide-react": "^1.52.0",
    "next": "^16.2.4",
    "next-intl": "^4.8.3",
    "next-themes": "^0.4.6",
    "playwright": "^1.51.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-markdown": "^10.1.0",
    "sql.js": "^1.14.1",
    "use-debounce": "^10.1.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@next/eslint-plugin-next": "^16.2.11",
    "@swc/core": "^1.10.18",
    "@swc/helpers": "^0.5.23",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/better-sqlite3": "^7.6.11",
    "@types/jest": "^30.0.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-transform-require-ignore": "^0.1.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.1.7",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "tailwindcss": "^4",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "typescript": "^5"
  },
  "overrides": {
    "braces": "^3.0.3",
    "micromatch": "^4.0.8",
    "glob": "^10.0.0",
    "inflight": "^1.0.6",
    "abab": "^2.0.6",
    "@swc/core": "^1.10.18"
  },
  "allowScripts": {
    "@parcel/watcher": true,
    "@swc/core": true,
    "better-sqlite3": true,
    "unrs-resolver": true
  },
  "optionalDependencies": {
    "@swc/core-win32-x64-msvc": "^1.16.13"
  }
}
