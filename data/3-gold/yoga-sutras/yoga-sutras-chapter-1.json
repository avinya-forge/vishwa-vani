  {
    "id": "yoga-sutras_1_2",
    "chapter": 1,
    "verse": 2,
    "original": "योगश्चित्तवृत्तिनिरोधः ॥ २ ॥",
    "transliteration": "yogaścittavṛttinirodhaḥ || 2 ||",
    "ai_metadata": {
      "topics": [
        "definition",
        "mind",
        "control"
      ]
    },
    "layers": [
      {
        "author": "patanjali",
        "lang": "en",
        "type": "translation",
        "content": "Yoga is the cessation of the modifications of the mind-stuff."
      }
    ],
    "text_slug": "yoga-sutras"
  },
  {
    "id": "yoga-sutras_1_3",
    "chapter": 1,
    "verse": 3,
    "original": "तदा द्रष्टुः स्वरूपेऽवस्थानम् ॥ ३ ॥",
    "transliteration": "tadā draṣṭuḥ svarūpe'vasthānam || 3 ||",
    "ai_metadata": {
      "topics": [
        "seer",
        "atman",
        "state"
      ]
    },
    "layers": [
      {
        "author": "patanjali",
        "lang": "en",
        "type": "translation",
        "content": "Then the Seer (Atman) abides in its own nature."
      }
    ],
    "text_slug": "yoga-sutras"
  },
  {
    "id": "yoga-sutras_1_4",
    "chapter": 1,
    "verse": 4,
    "original": "वृत्तिसारूप्यमितरत्र ॥ ४ ॥",
    "transliteration": "vṛttisārūpyamitaratra || 4 ||",
    "ai_metadata": {
      "topics": [
        "identification",
        "vrtis",
        "mind"
      ]
    },
    "layers": [
      {
        "author": "patanjali",
        "lang": "en",
        "type": "translation",
        "content": "At other times (when not in yoga), the Seer identifies with the modifications."
      }
    ],
    "text_slug": "yoga-sutras"
  },
  {
    "id": "yoga-sutras_1_5",
    "chapter": 1,
    "verse": 5,
    "original": "वृत्तयः पञ्चतय्यः क्लिष्टाक्लिष्टाः ॥ ५ ॥",
    "transliteration": "vṛttayaḥ pañcatayyaḥ kliṣṭākliṣṭāḥ || 5 ||",
    "ai_metadata": {
      "topics": [
        "vrttis",
        "types",
        "pain"
      ]
    },
    "layers": [
      {
        "author": "patanjali",
        "lang": "en",
        "type": "translation",
        "content": "There are five kinds of modifications, which can be either painful or non-painful."
      }
    ],
    "text_slug": "yoga-sutras"
  },
  {
    "id": "yoga-sutras_1_12",
    "chapter": 1,
    "verse": 12,
    "original": "अभ्यासवैराग्याभ्यां तन्निरोधः ॥ १२ ॥",
    "transliteration": "abhyāsavairāgyābhyāṃ tannirodhaḥ || 12 ||",
    "ai_metadata": {
      "topics": [
        "practice",
        "detachment",
        "remedy"
      ]
    },
    "layers": [
      {
        "author": "patanjali",
        "lang": "en",
        "type": "translation",
        "content": "The cessation of these modifications is achieved through Abhyasa (practice) and Vairagya (detachment)."
      }
    ],
    "text_slug": "yoga-sutras"
  },
  {
    "id": "yoga-sutras_1_13",
    "chapter": 1,
    "verse": 13,
    "original": "तत्र स्थितौ यत्नोऽभ्यासः ॥ १३ ॥",
    "transliteration": "tatra sthitau yatno'bhyāsaḥ || 13 ||",
    "ai_metadata": {
      "topics": [
        "abhyasa",
        "effort",
        "steadiness"
      ]
    },
    "layers": [
      {
        "author": "patanjali",
        "lang": "en",
        "type": "translation",
        "content": "Practice is the continuous effort to achieve sturdiness of the state of Yoga."
      }
    ],
    "text_slug": "yoga-sutras"
  },
  {
    "id": "yoga-sutras_1_14",
    "chapter": 1,
    "verse": 14,
    "original": "स तु दीर्घकालनैरन्तर्यसत्कारासेवितो दृढभूमिः ॥ १४ ॥",
    "transliteration": "sa tu dīrghakālanairantaryasatkārāsevito dṛḍhabhūmiḥ || 14 ||",
    "ai_metadata": {
      "topics": [
        "lifelong",
        "devotion",
        "grounding"
      ]
    },
    "layers": [
      {
        "author": "patanjali",
        "lang": "en",
        "type": "translation",
        "content": "Practice becomes firmly grounded when it has been cultivated for a long time, without interruption, and with devotion."
      }
    ],
    "text_slug": "yoga-sutras"
  },
  {
    "id": "yoga-sutras_1_15",
    "chapter": 1,
    "verse": 15,
    "original": "दृष्टानुश्रविकविषयवितृष्णस्य वशीकारसंज्ञा वैराग्यम् ॥ १५ ॥",
    "transliteration": "dṛṣṭānuśravikaviṣayavitṛṣṇasya vaśīkārasaṃjñā vairāgyam || 15 ||",
    "ai_metadata": {
      "topics": [
        "vairagya",
        "mastery",
        "desire"
      ]
    },
    "layers": [
      {
        "author": "patanjali",
        "lang": "en",
        "type": "translation",
        "content": "Vairagya is the consciousness of self-mastery in one who is free from craving for objects seen or heard about."
      }
    ],
    "text_slug": "yoga-sutras"
  }
]