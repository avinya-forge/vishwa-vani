# Claude Code context ignore rules
# These paths are never loaded into prompt context

# Version control internals
.git/**

# Package trees
node_modules/**

# Build artefacts
.next/**
out/**
build/**
coverage/**

# Tooling / deployment
.vercel/**
.yarn/**

# Generated & binary assets
public/*.db
public/static_search_fallback.json
docs/generated/**

# Logs and temp files
*.log
*.log.*
*.tmp
*.bak
npm-debug.log*
yarn-debug.log*
