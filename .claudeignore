# Claude Code context ignore rules
# These paths are never loaded into prompt context

# Version control internals — never useful as context
.git
.git/**

# Package trees — huge and irrelevant to product logic
node_modules
node_modules/**

# Build artefacts
.next
.next/**
out
out/**
build
build/**
coverage
coverage/**

# Tooling / deployment
.vercel
.vercel/**
.yarn
.yarn/**

# Generated & binary assets
public/*.db
public/static_search_fallback.json
docs/generated/**

# Logs and temp files
*.log
*.log.*
*.tmp
*.bak
npm-debug.log*
yarn-debug.log*
