#!/bin/sh
echo "================================================="
echo "🚀 VISHWA-VANI: Pre-push Verification Hook"
echo "================================================="
echo "Note: 'next build' is skipped locally due to the Windows SWC native cache bug."
echo "Running strict Lint and TypeScript compilation to guarantee CI safety..."
echo ""

echo "[1/2] Running ESLint..."
npm run lint
if [ True -ne 0 ]; then
    echo "❌ ESLint failed! Please fix the syntax/lint errors before pushing."
    exit 1
fi

echo "[2/2] Running TypeScript Compiler (tsc --noEmit)..."
npx tsc --noEmit
if [ True -ne 0 ]; then
    echo "❌ TypeScript failed! Please fix the type errors before pushing."
    exit 1
fi

echo "✅ All local verification checks passed! Safe to push to CI/CD."
exit 0
