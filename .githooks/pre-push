#!/bin/sh
# ==============================================================================
# VISHWA-VANI: Pre-push Verification Hook
# ==============================================================================

echo "================================================="
echo "🚀 VISHWA-VANI: Pre-push Verification Hook"
echo "================================================="
echo "Running strict verification suite (Lint, TSC, Jest) via npm run verify..."

if ! npm run verify; then
    echo "❌ Verification failed! Please fix the errors before pushing."
    exit 1
fi

echo "✅ All local verification checks passed! Safe to push to CI/CD."
exit 0
